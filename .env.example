# Copy to .env and fill in. Leave a key blank to run that stage in mock mode.

# Which LLM understands + replies: claude or openai
LLM_PROVIDER=claude

# OpenAI. https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Only for reasoning models (gpt-5*, o*); leave blank otherwise
OPENAI_REASONING_EFFORT=

# Claude. https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Sarvam AI (Indian-language speech-to-text + text-to-speech). https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=

# Khata Dost
SHOP_NAME=Sharma Store
# Set on a public link so visitors cannot reset the demo khata
RESET_PIN=
